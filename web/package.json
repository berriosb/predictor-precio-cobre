{
  "name": "copper-forecast-lab",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "data:export": "python3 ../scripts/export_web_data.py",
    "dev": "next dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm data:export && next build"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.5"
    }
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
