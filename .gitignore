# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Source lib dirs for Python packaging; ignore but allow web/src/lib (Next.js app) below.
lib/
!web/src/lib/
lib64/

parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb_checkpoints/
notebooks/data
notebooks/cifar_net.pth

# Datos
data/raw/*.csv
data/processed/*.csv
data/raw/*.xlsx
data/processed/*.xlsx
data/raw/*.json
data/processed/*.json
# Excepciones: mantener archivos pequeños de metadata
!data/processed/features_summary.csv
!data/processed/model_comparison_all.csv
!data/processed/precio_cobre_features.csv
!data/**/.gitkeep

# Modelos entrenados
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
# Excepciones: mantener modelos pequeños y CSVs
!models/ridge_model.pkl
!models/linear_regression.pkl
!models/best_model.pkl
!models/feature_names.pkl
!models/*.csv
!models/*.json
!models/.gitkeep

# Reportes
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.pdf
# Excepciones: mantener visualizaciones clave (pequeñas)
!reports/figures/model_comparison_metrics.png
!reports/figures/predictions_comparison_all_models.png
!reports/**/.gitkeep

# Entornos virtuales
venv/
env/
ENV/
.venv

